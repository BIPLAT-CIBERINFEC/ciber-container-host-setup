# CIBER SMTP relay configuration.
# Copy this file to /etc/ciber-smtp-relay.env and edit values on the VM.
# Do not commit real passwords.

# host-postfix installs/configures Postfix directly on the VM.
# container-postfix runs a dedicated Postfix relay container under /srv.
SMTP_RELAY_MODE="host-postfix"

# Institutional SMTP endpoint used by the local relay.
SMTP_RELAY_UPSTREAM_HOST="change_me_smtp_host"
SMTP_RELAY_UPSTREAM_PORT="25"
SMTP_RELAY_TLS_SECURITY_LEVEL="may"
SMTP_RELAY_TLS_CA_FILE="/etc/ssl/certs/ca-certificates.crt"

# Use auto to enable auth only when user/password are filled.
SMTP_RELAY_UPSTREAM_AUTH="auto"
SMTP_RELAY_UPSTREAM_USER=""
SMTP_RELAY_UPSTREAM_PASSWORD=""

# Local Postfix identity and network policy.
SMTP_RELAY_MYHOSTNAME="ciber-smtp-relay"
SMTP_RELAY_MYORIGIN="localhost"
SMTP_RELAY_MYDESTINATION="localhost"
SMTP_RELAY_MYNETWORKS="auto"
SMTP_RELAY_INET_INTERFACES="auto"
SMTP_RELAY_INET_PROTOCOLS="all"

# Used only by container-postfix mode.
SMTP_RELAY_CONTAINER_ROOT="/srv/containers/shared/smtp-relay"
SMTP_RELAY_CONTAINER_NAME="ciber-smtp-relay"
SMTP_RELAY_BIND_HOST="0.0.0.0"
SMTP_RELAY_BIND_PORT="25"

# Values printed for application/orchestrator env files.
SMTP_APP_HOST="host.docker.internal"
SMTP_APP_PORT="25"
SMTP_DEFAULT_FROM_EMAIL="change_me_from_email"
