# Example host bootstrap configuration.
# Copy to a local file outside git or export values before running the script.

DEPLOY_USER=bioinfoadm

# Space-separated application names. These are directory names, not Git URLs.
APPS="pathocore-web pathocore-api mepram-omop-api"

APP_ROOT=/opt/container_apps
LOG_ROOT=/var/log/local
CONTAINER_ROOT=/srv/containers

DOCKER_DATA_ROOT=/srv/containers/storage
CONTAINERD_ROOT=/srv/containers/containerd

DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5
