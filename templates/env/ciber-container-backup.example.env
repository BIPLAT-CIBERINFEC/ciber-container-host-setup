# CIBER container host backup configuration.
# Copy this file to /etc/ciber-container-backup.env and edit values on the VM.
# Do not commit real passwords.

BACKUP_ROOT="/srv/containers/backup/host"
LOG_DIR="/var/log/local/container-backup"
CONTAINER_BIND_ROOT="/srv/containers/bind"
BACKUP_RETENTION_DAYS=14
LOG_RETENTION_DAYS=30

BACKUP_BIND_MOUNTS=true
BACKUP_DOCKER_VOLUMES=true
BACKUP_DOCKER_IMAGES=true
BACKUP_DATABASES=true

# Optional regular expression matched against Docker volume names.
# Example: exclude temporary cache volumes.
DOCKER_VOLUME_EXCLUDE_REGEX=""

# Database passwords are referenced indirectly by variable name.
# Keep real values only in this local config file.
PATHOCORE_DB_PASSWORD="change_me"
KEYCLOAK_DB_PASSWORD="change_me"
MEPRAM_OMOP_DB_PASSWORD="change_me"

# Format per line:
# backup_name|container_name|database_name|database_user|password_env_var
CIBER_BACKUP_DATABASES="
pathocore_api|pathocore-pathocore_db-1|pathocore_api|pathocore|PATHOCORE_DB_PASSWORD
keycloak|pathocore-keycloak_db-1|keycloak|keycloak|KEYCLOAK_DB_PASSWORD
mepram_omop_api|pathocore-mepram_omop_db-1|mepram_omop_api|mepram|MEPRAM_OMOP_DB_PASSWORD
"
